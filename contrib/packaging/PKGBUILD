# Maintainer: yosana <https://github.com/y0sh-dev>
pkgname=y4p
pkgver=1.0.0
pkgrel=1
pkgdesc='A robust, unified clipboard manager for Wayland with SQLite storage'
arch=('x86_64' 'aarch64')
url='https://github.com/y0sh-dev/y4p'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=(
    'imagemagick: optional image sanitisation when [image] sanitize = true'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --workspace
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    install -Dm755 "target/release/y4p" "${pkgdir}/usr/bin/y4p"
    install -Dm644 "contrib/systemd/y4p.service" "${pkgdir}/usr/lib/systemd/user/y4p.service"
    install -Dm644 "completions/_y4p" "${pkgdir}/usr/share/zsh/site-functions/_y4p"
    install -Dm644 "y4p.toml.example" "${pkgdir}/usr/share/doc/${pkgname}/y4p.toml.example"
    install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 "README_ja.md" "${pkgdir}/usr/share/doc/${pkgname}/README_ja.md"
    install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
