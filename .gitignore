# --- Rust Artifacts ---
# Unanchored on purpose: besides the workspace `target/`, some crate tests
# create scratch directories under `<crate>/target/` (via CARGO_MANIFEST_DIR).
target/
/.idea/

# --- Storage / Databases ---
# Block SQLite databases and transaction logs anywhere in the workspace
*.sqlite
*.sqlite-wal
*.sqlite-shm

# --- Backup & Temporary Files ---
src/**/*.rs.bak
*.bak
*.tmp

# --- Neovim / Editor Junk ---
*.swp
*.swo
*~
*.un~
Session.vim

# --- OS Junk ---
.DS_Store
Thumbs.db

# --- Agent Instructions / Local Metadata ---
GEMINI.md

